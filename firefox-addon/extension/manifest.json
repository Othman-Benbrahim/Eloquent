{
  "manifest_version": 3,
  "name": "Eloquent Local Assistant",
  "short_name": "Eloquent",
  "version": "0.1.6",
  "description": "Correction grammaticale et orthographique locale dans les champs de texte de Firefox.",
  "author": "Othman Benbrahim and contributors",
  "homepage_url": "https://github.com/Othman-Benbrahim/Eloquent",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/core.js",
      "background/background.js"
    ],
    "type": "classic"
  },
  "action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Eloquent Local Assistant",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/core.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "eloquent-local-assistant@othman-benbrahim.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
